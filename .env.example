REQ2TEST_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Async task platform
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set true only for local debugging without a running worker.
REQ2TEST_EAGER_TASKS=false
# local/development/test may use the in-memory TaskStore fallback; production may not.
REQ2TEST_ENV=local

# PostgreSQL business data store (development values only)
POSTGRES_DB=req2test
POSTGRES_USER=req2test
POSTGRES_PASSWORD=req2test_dev
DATABASE_URL=postgresql+psycopg://req2test:req2test_dev@localhost:5432/req2test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Bounded, sanitized terminal result persistence
RESULT_TEXT_MAX_CHARS=4000
RESULT_PAYLOAD_MAX_BYTES=1048576

# Persistent RAG knowledge base
REQ2TEST_CHROMA_DIR=.req2test/chroma
REQ2TEST_CHROMA_COLLECTION=req2test_knowledge

# HTTP execution safety
# Remote execution is disabled by default to reduce SSRF risk when the API is deployed.
REQ2TEST_ALLOW_REMOTE_EXECUTION=false
REQ2TEST_EXECUTION_ALLOWED_HOSTS=localhost,127.0.0.1,::1,api
