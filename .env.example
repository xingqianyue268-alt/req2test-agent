REQ2TEST_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Async task platform
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set true only for local debugging without a running worker.
REQ2TEST_EAGER_TASKS=false
# Evaluation Center datasets and optional local synchronous execution.
REQ2TEST_EVAL_DATASET_DIR=evals
REQ2TEST_EAGER_EVALUATIONS=false
# Online Judge/generation may read this dedicated key; Demo evaluation never reads it.
REQ2TEST_EVAL_API_KEY=
# local/development/test may use the in-memory TaskStore fallback; production may not.
REQ2TEST_ENV=local

# PostgreSQL business data store (development values only)
POSTGRES_DB=req2test
POSTGRES_USER=req2test
POSTGRES_PASSWORD=req2test_dev
DATABASE_URL=postgresql+psycopg://req2test:req2test_dev@localhost:5432/req2test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Bounded, sanitized terminal result persistence
RESULT_TEXT_MAX_CHARS=4000
RESULT_PAYLOAD_MAX_BYTES=1048576

# Authentication (generate a unique production value, e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=replace-with-a-random-production-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Production defaults to false. Enable only for an explicit local/demo environment.
ALLOW_ANONYMOUS_DEMO=false
# Use false only for a local HTTP-only browser session; production should keep true.
AUTH_COOKIE_SECURE=true

# Persistent RAG knowledge base
REQ2TEST_CHROMA_DIR=.req2test/chroma
REQ2TEST_CHROMA_COLLECTION=req2test_knowledge

# HTTP execution safety
# Remote execution is disabled by default to reduce SSRF risk when the API is deployed.
REQ2TEST_ALLOW_REMOTE_EXECUTION=false
REQ2TEST_EXECUTION_ALLOWED_HOSTS=localhost,127.0.0.1,::1,api

# Render single-service overrides (render.yaml sets these automatically).
# Memory projections require BOTH eager flags; keep redis for Compose workers.
REQ2TEST_TASK_STORE=redis
REQ2TEST_AUTO_MIGRATE=false
REQ2TEST_CHROMA_EPHEMERAL=false
# Optional direct Neon URL for migrations; never commit a real connection string.
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database?sslmode=require
